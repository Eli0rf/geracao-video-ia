# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Geração de Vídeo por IA
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── API ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production | test
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/geracao_video.db
DATABASE_URL_TEST=sqlite:///./data/test.db

# ─── Geração de vídeo ─────────────────────────────────────────────────────────
# Modelo padrão: wan2.1 | cogvideox | hunyuan | animatediff
DEFAULT_MODEL=animatediff

# Diretório onde os vídeos gerados são salvos
OUTPUT_DIR=./outputs/videos

# Timeout máximo por job (segundos)
JOB_TIMEOUT_SECONDS=600

# Máximo de jobs simultâneos (1 recomendado por limitação de VRAM)
MAX_CONCURRENT_JOBS=1

# ─── Fila de tarefas (Celery + Redis) — E12 / ADR-009 ──────────────────────────
# background = roda no mesmo processo da API (dev/teste, não precisa de Redis)
# celery     = enfileira no Redis e processa num worker dedicado (produção)
TASK_BACKEND=background

# URLs do broker e do backend de resultados
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Executa as tasks em memória, sem broker (apenas para testes isolados)
CELERY_TASK_ALWAYS_EAGER=false

# Tarefas simultâneas por worker (1 = uma GPU, sem contenção de VRAM)
CELERY_CONCURRENCY=1

# ─── Dupla IA / Validador ─────────────────────────────────────────────────────
# Chave da API Gemini para o agente validador (gratuito em aistudio.google.com)
GEMINI_API_KEY=

# ─── HuggingFace ──────────────────────────────────────────────────────────────
# Token de acesso ao HuggingFace Hub (gratuito em hf.co)
# Necessário apenas para modelos com acesso restrito
HF_TOKEN=

# Diretório local de cache dos modelos (evita re-download)
HF_HOME=~/.cache/huggingface

# ─── Hardware ─────────────────────────────────────────────────────────────────
# Forçar uso de CPU mesmo com GPU disponível (para testes)
FORCE_CPU=false
